{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/html/index.html"
    },
    {
      "source": "/(analytics|auth|createnew|index|quotation|recents|shared)\\.html",
      "destination": "/html/$1.html"
    }
  ]
}
