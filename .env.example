# InvoZap Backend Environment Configuration
# Copy this file to .env and replace placeholders with your real credentials

# Port for the Express server (default: 5000)
PORT=5000

# MongoDB Connection String (Atlas SRV or local MongoDB URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/invozap?retryWrites=true&w=majority

# JWT Signing Secret (CRITICAL: Must be at least 32 characters long)
JWT_SECRET=invozap_super_secret_jwt_key_2026_production

# Node environment mode: development | production
NODE_ENV=development

# Optional: CORS allowed origin if frontend is hosted on a separate port/origin
# In standard deployment, Express serves the frontend from /public on the same origin.
# CLIENT_URL=http://localhost:5500

# Optional: Set to "true" to force Google Public DNS (8.8.8.8) for MongoDB SRV resolution
# CUSTOM_DNS=false
